{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["src/components/*"],
      "@/components": ["src/components"],
      "@/components/ui/*": ["src/components/ui/*"],
      "@/components/ui": ["src/components/ui"],
      "@/components/common/*": ["src/components/common/*"],
      "@/components/common": ["src/components/common"],
      "@/components/layout/*": ["src/components/layout/*"],
      "@/components/feedback/*": ["src/components/feedback/*"],
      "@/components/navigation/*": ["src/components/navigation/*"],
      "@/components/feature/*": ["src/components/feature/*"],
      "@/components/feature": ["src/components/feature"],
      "@/screens/*": ["src/screens/*"],
      "@/screens": ["src/screens"],
      "@/hooks/*": ["src/hooks/*"],
      "@/hooks": ["src/hooks"],
      "@/services/*": ["src/services/*"],
      "@/services": ["src/services"],
      "@/api/*": ["src/api/*"],
      "@/api": ["src/api"],
      "@/store/*": ["src/store/*"],
      "@/store": ["src/store"],
      "@/providers/*": ["src/providers/*"],
      "@/providers": ["src/providers"],
      "@/constants/*": ["src/constants/*"],
      "@/constants": ["src/constants"],
      "@/utils/*": ["src/utils/*"],
      "@/utils": ["src/utils"],
      "@/lib/*": ["src/lib/*"],
      "@/lib": ["src/lib"],
      "@/theme/*": ["src/theme/*"],
      "@/theme": ["src/theme"],
      "@/types/*": ["src/types/*"],
      "@/types": ["src/types"],
      "@/assets/*": ["assets/*"],
      "@/assets": ["assets"],
      "@/navigation/*": ["src/navigation/*"],
      "@/navigation": ["src/navigation"],

      "@/components/inputs/*": ["src/components/ui/inputs/*"],
      "@/components/inputs": ["src/components/ui/inputs"],
      "@/components/Button": ["src/components/ui/Button.tsx"],
      "@/components/TextField": ["src/components/ui/TextField.tsx"],
      "@/components/Themed": ["src/components/ui/Themed.tsx"],
      "@/components/StyledText": ["src/components/ui/StyledText.tsx"],
      "@/components/ExternalLink": ["src/components/ui/ExternalLink.tsx"],
      "@/components/EditScreenInfo": ["src/components/ui/EditScreenInfo.tsx"],
      "@/components/ListingStatusTag": ["src/components/ui/ListingStatusTag.tsx"],
      "@/components/useColorScheme": ["src/components/ui/useColorScheme.ts"],
      "@/components/useColorScheme.web": ["src/components/ui/useColorScheme.web.ts"],
      "@/components/useClientOnlyValue": ["src/components/ui/useClientOnlyValue.ts"],
      "@/components/useClientOnlyValue.web": ["src/components/ui/useClientOnlyValue.web.ts"],
      "@/components/ListingCard": ["src/components/common/ListingCard.tsx"],
      "@/components/bookings/*": ["src/components/feature/booking/*"],
      "@/components/bookings": ["src/components/feature/booking"],
      "@/components/home/*": ["src/components/feature/home/*"],
      "@/components/home": ["src/components/feature/home"],
      "@/components/landlord/*": ["src/components/feature/landlord/*"],
      "@/components/landlord": ["src/components/feature/landlord"],
      "@/components/listings/*": ["src/components/feature/listing/*"],
      "@/components/listings": ["src/components/feature/listing"],
      "@/components/payments/*": ["src/components/feature/payments/*"],
      "@/components/payments": ["src/components/feature/payments"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
